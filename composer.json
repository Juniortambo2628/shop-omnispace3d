{
    "require": {
        "phpmailer/phpmailer": "^7.0",
        "dompdf/dompdf": "^3.1",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.0",
        "intervention/image": "^4.0",
        "respect/validation": "^2.2",
        "guzzlehttp/guzzle": "^7.5",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
