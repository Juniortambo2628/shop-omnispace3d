# Environment & secrets
.env
.env.local
.env.production
.env.*.local

# SSH keys for GitHub Actions deployment
github-actions-omnispace
github-actions-omnispace.pub

# PHP Composer
/vendor/
composer.phar

# Laravel / app runtime
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/logs/*
!/logs/.gitkeep

# User-uploaded product images (preserve on server; do not version)
/static/images/products/*
!/static/images/products/.gitkeep
!/static/images/products/.htaccess

# Dev-only public junction/copy of static (production deploys static separately)
/public/static/

# IDE & OS
/.idea/
/.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Python legacy (not used)
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Databases & local dumps
*.sqlite3
omnishop.db
*.sql.gz

